{
	"name": "RealLastUpdate",
	"version": "0.1.0",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-RealLastUpdate",
	"descriptionmsg": "reallastupdate-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\RealLastUpdate\\": "includes/"
	},
	"ConfigRegistry": {
		"reallastupdate": "GlobalVarConfig::newInstance"
	},
	"config": {
		"RealLastUpdateBotGroups": {
			"value": [ "bot" ],
			"merge_strategy": "provide_default",
			"description": "User groups to consider as bots"
		},
		"RealLastUpdateSourceWiki": {
			"value": null,
			"description": "Source wiki name"
		},
		"RealLastUpdateSourceWikiApi": {
			"value": "https://he.example.org/w/api.php",
			"description": "API URL for the source wiki"
		},
		"RealLastUpdateSourceWikiDb": {
			"value": null,
			"description": "Database identifier for direct access to source wiki database"
		}
	},
	"Hooks": {
		"OutputPageParserOutput": "main",
		"PageSaveComplete": "main",
		"LoadExtensionSchemaUpdates": "main",
		"GetPreferences": "main",
		"ArticleDeleteComplete": "main"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\RealLastUpdate\\Hooks"
		}
	},
	"MessagesDirs": {
		"RealLastUpdate": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.realLastUpdate.special": {
			"styles": "resources/ext.realLastUpdate.special/index.css",
			"scripts": "resources/ext.realLastUpdate.special/index.js",
			"messages": [
				"reallastupdate-show-all-dates"
			],
			"dependencies": [
				"oojs-ui-core",
				"oojs-ui-widgets",
				"mediawiki.api",
				"mediawiki.user"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "WikiRights/RealLastUpdate"
	},
	"SpecialPages": {
		"RealLastUpdate": "MediaWiki\\Extension\\RealLastUpdate\\SpecialRealLastUpdate"
	},
	"ExtensionMessagesFiles": {
		"RealLastUpdateAlias": "i18n/RealLastUpdate.alias.php"
	},
	"APIModules": {
		"reallastupdate": {
			"class": "MediaWiki\\Extension\\RealLastUpdate\\Api\\ApiRealLastUpdate"
		}
	},
	"manifest_version": 2
}
